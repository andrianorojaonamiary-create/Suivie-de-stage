# Pas de legacy-peer-deps : npm installe automatiquement les peerDependencies,
# ce dont recharts a besoin (react-is).
#
# Le conflit historique venait de ajv : le backend exige ajv@6 via
# @eslint/eslintrc (peer d'eslint 9), tandis que @hookform/resolvers déclare
# ajv@8 en peerOptional. Il est résolu en épinglant explicitement ajv@8 côté
# frontend (cf. frontend/package.json) : npm le place dans frontend/node_modules
# et laisse ajv@6 à la racine pour eslint. Les deux sont alors satisfaits.
audit=false
fund=false
