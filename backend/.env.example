DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# Mot de passe du rôle superutilisateur de votre serveur PostgreSQL local.
# Ce n'est PAS une valeur par défaut : vérifiez-le avec votre installation
# (pgAdmin > Servers > your server > right-click > Properties, ou psql).
DB_PASSWORD=mot_de_passe_de_votre_utilisateur_postgres
DB_DATABASE=emit_careertrack
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1h

# URL du frontend (utilisée pour le lien de réinitialisation + CORS).
# Plusieurs origines possibles, séparées par des virgules.
FRONTEND_URL=http://localhost:5173

# SMTP — envoi d'emails (mot de passe oublié).
# Exemple Gmail : créer un "mot de passe d'application" dans
# https://myaccount.google.com/apppasswords puis le coller dans SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your@gmail.com

# Compte administrateur initial.
# POST /api/users exige déjà le rôle ADMINISTRATEUR : sur une base neuve, ce
# seed est donc le seul moyen d'obtenir un administrateur. Ensuite, les
# suivants se créent par POST /api/users, ou un rôle se requalifie par
# PATCH /api/users/:id.
#
#   npm run seed:admin              crée le compte s'il est absent
#   npm run seed:admin -- --reset   réécrit le mot de passe s'il existe déjà
#
# Sans --reset, un compte déjà présent n'est jamais modifié.
ADMIN_EMAIL=admin@votre-domaine.fr
ADMIN_PASSWORD=changez_moi_8_caracteres_minimum
ADMIN_NOM=Administrateur
ADMIN_PRENOM=EMIT
