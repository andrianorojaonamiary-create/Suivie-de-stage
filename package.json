{
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "typeorm": "npm run typeorm --workspace=backend --",
    "migration:generate": "npm run migration:generate --workspace=backend",
    "migration:run": "npm run migration:run --workspace=backend",
    "migration:revert": "npm run migration:revert --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "unrs-resolver": true,
    "core-js": true
  }
}
